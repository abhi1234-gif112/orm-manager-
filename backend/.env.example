# Copy to backend/.env for local (non-Docker) development.
# In Docker Compose, these are supplied by ../.env.saptanga.example -> .env.saptanga instead.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://saptanga:CHANGE_ME@localhost:5432/saptanga_newsroom

SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME

AI_FAST_MODEL_PROVIDER=anthropic
AI_FAST_MODEL_NAME=claude-haiku-4-5
AI_REASONING_MODEL_PROVIDER=anthropic
AI_REASONING_MODEL_NAME=claude-sonnet-5

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=saptanga-newsroom-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Distribution platform credentials -- populated in Phase 6, official APIs only.
INSTAGRAM_ACCESS_TOKEN=CHANGE_ME
INSTAGRAM_BUSINESS_ACCOUNT_ID=CHANGE_ME
X_API_KEY=CHANGE_ME
X_API_SECRET=CHANGE_ME
X_ACCESS_TOKEN=CHANGE_ME
X_ACCESS_SECRET=CHANGE_ME

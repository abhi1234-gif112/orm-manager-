# SAPTANGA Newsroom -- copy to .env.saptanga for docker-compose.saptanga.yml.
# Kept separate from .env.example / .env, which belong to the existing NAZAR platform in
# packages/ -- see docs/ARCHITECTURE.md section 0.

# ── Postgres (pgvector) ─────────────────────────────────────────────────────
SAPTANGA_POSTGRES_USER=saptanga
SAPTANGA_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SAPTANGA_POSTGRES_DB=saptanga_newsroom
SAPTANGA_POSTGRES_PORT=5433

# ── Redis (task queue only) ─────────────────────────────────────────────────
SAPTANGA_REDIS_PORT=6380

# ── Backend ──────────────────────────────────────────────────────────────────
SAPTANGA_BACKEND_PORT=8000
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=saptanga-newsroom-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ── Distribution (official APIs only) ───────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=CHANGE_ME
INSTAGRAM_BUSINESS_ACCOUNT_ID=CHANGE_ME
X_API_KEY=CHANGE_ME
X_API_SECRET=CHANGE_ME
X_ACCESS_TOKEN=CHANGE_ME
X_ACCESS_SECRET=CHANGE_ME

# ── Frontend ─────────────────────────────────────────────────────────────────
SAPTANGA_WEBSITE_PORT=3000
SAPTANGA_NEWSROOM_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME

# ── n8n (cross-service glue only, per docs/ARCHITECTURE.md) ────────────────
SAPTANGA_N8N_PORT=5678
N8N_BASIC_AUTH_USER=CHANGE_ME
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
